# Copy to .env and fill in. NEVER commit your real key.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: which Claude model the coach uses (default: claude-opus-5).
# For a cheaper/faster coach you can set: claude-haiku-4-5
COACH_MODEL=claude-opus-5
# Optional: port (default 8787)
PORT=8787

# --- friends and leaderboards (docs/ACCOUNTS.md) ---------------------------
# Leave these unset and friends/boards are simply off; the game is unaffected.
#
# Every client id you ship. A provider with no id configured is REFUSED rather
# than falling back to accepting any audience — a server that accepts every
# token is worse than one that accepts none.
APPLE_CLIENT_ID=
# iOS, Android and web are different Google ids and all are "this app".
GOOGLE_CLIENT_IDS=

# Browsers only; a native app sends no Origin and is always allowed.
ALLOWED_ORIGINS=

# Where the SQLite file lives. It holds real training logs — back it up, and
# never commit it.
# FRIENDS_DB=./friends.db

# Set behind a reverse proxy, or every request looks like it came from the
# proxy and one busy player rate-limits everyone else.
# TRUST_PROXY=1
